{
  "name": "healthguard-ai-desktop",
  "version": "1.0.0",
  "description": "Healthcare Zero-Trust PII Anonymization & Clinical RAG Desktop Workstation",
  "main": "main.js",
  "author": "HealthGuard Healthcare Technologies",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "org.healthguard.clinical.workstation",
    "productName": "HealthGuard AI",
    "directories": {
      "output": "../dist/electron"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HealthGuard AI"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
