<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="HealthGuardAI.HospitalWorkstation"
    Publisher="CN=HealthGuard Healthcare Technologies"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>HealthGuard AI — Healthcare Zero-Trust Workstation</DisplayName>
    <PublisherDisplayName>HealthGuard Healthcare Technologies</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
    <Description>Dual-compliance (US HIPAA 18 Safe Harbor + India DPDP Act 2023 / ABDM) Zero-Trust Healthcare RAG Clinical Workstation.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application
      Id="HealthGuardAI"
      Executable="HealthGuard-AI.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="HealthGuard AI"
        Description="Zero-Trust Healthcare RAG Clinical Workstation"
        BackgroundColor="#0b0f19"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">

        <uap:DefaultTile
          Wide310x150Logo="assets\Wide310x150Logo.png"
          ShortName="HealthGuard AI">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>

        <uap:SplashScreen
          BackgroundColor="#0b0f19"
          Image="assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="HealthGuard-AI.exe" />
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
