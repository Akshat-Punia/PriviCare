<?xml version="1.0" encoding="utf-8"?>
<!--
  PriviCare — WiX v4/v5+ Installer Definition
  Generates a proper Windows Installer (.msi) package.
  
  Build with: wix build installer/privicare.wxs -o dist/PriviCare_Setup.msi -arch x64
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="PriviCare"
    Manufacturer="PriviCare Healthcare Technologies"
    Version="2.0.0"
    UpgradeCode="B3D5F9A2-4C6E-5B7D-AE8F-3E2C1D9B6F4A"
    Scope="perMachine">

    <SummaryInformation
      Description="PriviCare — Doctor Clinical Intelligence &amp; Secure RAG Suite. Care in Every Data Beat."
      Manufacturer="PriviCare Healthcare Technologies" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of PriviCare is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="PriviCareIcon.exe" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="PriviCareIcon.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Akshat-Punia/Healthcare-PII-Anonymization-for-RAG-Pipelines" />
    <Property Id="ARPCOMMENTS" Value="PriviCare — Care in Every Data Beat. Zero-Trust Healthcare Workstation." />

    <Feature Id="PriviCareFeature" Title="PriviCare Application" Level="1">
      <ComponentGroupRef Id="PriviCareComponents" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <!-- Installation directory structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PriviCare">
        <Component Id="PriviCareExeComponent" Guid="C1A2B3D4-E5F6-7890-ABCD-EF1234567890">
          <File Id="PriviCareExe"
                Source="dist\PriviCare.exe"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="D2B3C4E5-F6A7-8901-BCDE-F12345678901">
        <Shortcut Id="DesktopShortcut"
                  Name="PriviCare"
                  Description="PriviCare — Care in Every Data Beat"
                  Target="[INSTALLFOLDER]PriviCare.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PriviCareIcon.exe" />
        <RemoveFolder Id="RemoveDesktopShortcut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PriviCare" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start Menu Shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="PriviCare">
        <Component Id="StartMenuShortcutComponent" Guid="E3C4D5F6-A7B8-9012-CDEF-123456789012">
          <Shortcut Id="StartMenuShortcut"
                    Name="PriviCare"
                    Description="PriviCare — Care in Every Data Beat"
                    Target="[INSTALLFOLDER]PriviCare.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="PriviCareIcon.exe" />
          <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\PriviCare" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

  </Package>

  <Fragment>
    <ComponentGroup Id="PriviCareComponents">
      <ComponentRef Id="PriviCareExeComponent" />
    </ComponentGroup>
  </Fragment>

</Wix>
